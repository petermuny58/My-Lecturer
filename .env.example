# My Lecturer - Environment Configuration Template
# Copy this file to '.env.local' and fill in your actual credentials.

# 1. Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Books API Key (Obtain from Google Developers Console)
VITE_GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here
